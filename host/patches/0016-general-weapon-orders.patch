 // ------------------------------------------------------------------------------------------------
 void WeaponSet::loadPostProcess()
 {
+
+}
 
+//-------------------------------------------------------------------------------------------------
+// ZHBO: the slot gets a fresh weapon of `tmpl` (a full clip); the lock and the current choice
+// stay. The old weapon is deleted at the end of the frame, like updateWeaponSet's. A saved
+// weapon keeps its template by name (Weapon::xfer), so a swap survives save/load.
+void WeaponSet::zhboSetSlotWeapon(const Object* obj, WeaponSlotType wslot, const WeaponTemplate* tmpl)
+{
+	if (tmpl == nullptr || wslot < PRIMARY_WEAPON || wslot >= WEAPONSLOT_COUNT)
+		return;
+	if (m_weapons[wslot] != nullptr && m_weapons[wslot]->getTemplate() == tmpl)
+		return;
+	TheWeaponStore->deleteWeaponDeferred(m_weapons[wslot]);
+	m_weapons[wslot] = TheWeaponStore->allocateNewWeapon(tmpl, wslot);
+	m_weapons[wslot]->loadAmmoNow(obj);
+	m_filledWeaponSlotMask = 0;
+	m_totalAntiMask = 0;
+	m_totalDamageTypeMask.clear();
+	m_hasPitchLimit = false;
+	m_hasDamageWeapon = false;
+	for (Int i = PRIMARY_WEAPON; i < WEAPONSLOT_COUNT; ++i)
+	{
+		if (m_weapons[i] == nullptr)
+			continue;
+		m_filledWeaponSlotMask |= (1 << i);
+		m_totalAntiMask |= m_weapons[i]->getAntiMask();
+		m_totalDamageTypeMask.set(m_weapons[i]->getDamageType());
+		if (m_weapons[i]->isPitchLimited())
+			m_hasPitchLimit = true;
+		if (m_weapons[i]->isDamageWeapon())
+			m_hasDamageWeapon = true;
+	}
 }
 
