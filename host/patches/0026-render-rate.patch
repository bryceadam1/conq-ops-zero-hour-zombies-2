+// ZHBO: farther than this in one logic frame is a teleport, drawn where it lands.
+static const Real ZHBO_INTERPOLATION_SNAP_DISTANCE = 100.0f;
+
+static Bool zhboIsRotation(const Matrix3D &m)
+{
+	for (Int c = 0; c < 3; ++c)
+	{
+		const Real len2 = m[0][c] * m[0][c] + m[1][c] * m[1][c] + m[2][c] * m[2][c];
+		if (fabs(len2 - 1.0f) > 0.02f)
+			return FALSE;
+	}
+	return TRUE;
+}
+
+const Matrix3D *Drawable::getRenderTransformMatrix()
+{
+	const Matrix3D *now = getTransformMatrix();
+	// A client-only drawable is placed by the client each render update; at a logic rate at or
+	// above the render's there is nothing between frames to draw.
+	if (getObject() == nullptr || TheGameLogic == nullptr || TheFramePacer == nullptr ||
+		TheFramePacer->getActualLogicTimeScaleOverFpsRatio() >= 1.0f)
+	{
+		m_zhboInterpolating = FALSE;
+		return now;
+	}
+	const UnsignedInt frame = TheGameLogic->getFrame();
+	if (!m_zhboInterpolating || frame != m_zhboToFrame)
+	{
+		// From the previous logic frame's transform, if this drawable was drawn on it; else from here.
+		const Bool consecutive = m_zhboInterpolating && frame == m_zhboToFrame + 1;
+		m_zhboFromTransform = consecutive ? m_zhboToTransform : *now;
+		m_zhboToFrame = frame;
+		m_zhboInterpolating = TRUE;
+	}
+	m_zhboToTransform = *now;
+
+	const Real phase = TheFramePacer->getLogicFramePhase();
+	const Vector3 from = m_zhboFromTransform.Get_Translation();
+	const Vector3 to = m_zhboToTransform.Get_Translation();
+	if (phase >= 1.0f || (to - from).Length2() > ZHBO_INTERPOLATION_SNAP_DISTANCE * ZHBO_INTERPOLATION_SNAP_DISTANCE)
+		return now;
+	const Real t = phase <= 0.0f ? 0.0f : phase;
+	if (zhboIsRotation(m_zhboFromTransform) && zhboIsRotation(m_zhboToTransform))
+	{
+		Quaternion q;
+		Slerp(q, Build_Quaternion(m_zhboFromTransform), Build_Quaternion(m_zhboToTransform), t);
+		Build_Matrix3D(q, m_zhboRenderTransform);
+	}
+	else
+	{
+		m_zhboRenderTransform = m_zhboToTransform;
+	}
+	m_zhboRenderTransform.Set_Translation(from + (to - from) * t);
+	return &m_zhboRenderTransform;
+}
