+// ZHBO: the textured beam's points (tail at the origin, head `length` along +X) and look. Additive:
+// the opacity scales the colour (white: the texture carries the tracer's colours).
+static void zhboShapeBeam(SegmentedLineClass *beam, Real length, Real width, Real opacity)
+{
+	Vector3 points[2] = { Vector3( 0.0f, 0.0f, 0.0f ), Vector3( length, 0.0f, 0.0f ) };
+	beam->Set_Points( 2, points );
+	beam->Set_Width( width );
+	beam->Set_Color( Vector3( opacity, opacity, opacity ) );
+	beam->Set_Opacity( 1.0f );
+}
