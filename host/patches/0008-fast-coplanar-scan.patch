+// ZHBO: the pair test of Has_Coplanar_Opposite_Triangle_Pairs for triangles i < j and their planes.
+static bool Is_Coplanar_Opposite_Pair(const Vector3 * verts, const Vector3 * norms, const TriIndex * polys,
+	int i, const Vector3 & ni, float di, int j, const Vector3 & nj, float dj)
+{
+	const bool opposite_face_planes =
+		Vector3::Dot_Product(ni, nj) < -0.999f && fabsf(di + dj) < 0.001f;
+	if (!opposite_face_planes) {
+		return false;
+	}
+	if (Triangles_Share_Positions(verts, polys[i], polys[j])) {
+		return true;
+	}
+	Vector3 vni;
+	Vector3 vnj;
+	return Triangle_Is_On_Plane(verts, polys[j], ni, di)
+		&& Projected_Triangle_Bounds_Overlap(verts, polys[i], polys[j], ni)
+		&& Compute_Averaged_Vertex_Normal(norms, polys[i], &vni)
+		&& Compute_Averaged_Vertex_Normal(norms, polys[j], &vnj)
+		&& Vector3::Dot_Product(vni, vnj) < -0.9f;
+}
+
