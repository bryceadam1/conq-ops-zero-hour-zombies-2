diff --git a/Core/GameEngine/Source/GameNetwork/Transport.cpp b/Core/GameEngine/Source/GameNetwork/Transport.cpp
index 1c105ea7c..ecb6e012f 100644
--- a/Core/GameEngine/Source/GameNetwork/Transport.cpp
