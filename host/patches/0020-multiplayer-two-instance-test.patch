 #include "Common/crc.h"
 #include "GameNetwork/Transport.h"
 #include "GameNetwork/NetworkInterface.h"
+#include "GameClient/ClientInstance.h"
+
+// ZHBO: loopback instance ports, for several game instances on one machine (a multiplayer test).
+// Each multi-client instance takes 127.0.0.<instance id> as its address (IPEnumeration). Linux and
+// Windows answer all of 127/8, but macOS only answers 127.0.0.1 until each extra address is added
+// as an alias (`sudo ifconfig lo0 alias 127.0.0.2 up`). With GGC_LOOPBACK_INSTANCE_PORTS set, a
+// multi-client instance keeps 127.0.0.<id> as its identity in the protocol but really lives on
+// 127.0.0.1, on ports offset by its id: <port> + <id> * LOOPBACK_PORT_STRIDE. A send to
+// 127.0.0.<id>:<port> goes to that instance's offset port, a broadcast goes to every other
+// instance's, and a datagram from 127.0.0.1:<port> + <id> * stride reads as coming from
+// 127.0.0.<id>:<port>. Nothing above the socket sees a difference, so the LAN lobby and the game
+// run their normal code, and no root-only setup is needed.
+namespace
+{
+enum { LOOPBACK_PORT_STRIDE = 100, LOOPBACK_MAX_INSTANCES = 16 };
+const UnsignedInt LOOPBACK_HOST = 0x7F000001u;
+
+Bool LoopbackInstancePorts()
+{
+	return rts::ClientInstance::isMultiInstance() && getenv("GGC_LOOPBACK_INSTANCE_PORTS") != nullptr;
+}
+
+// The instance behind a 127.0.0.<id> identity, or 0 for any other address.
+UnsignedInt LoopbackInstanceOf(UnsignedInt ip)
+{
+	if ((ip & 0xFFFFFF00u) != 0x7F000000u)
+		return 0;
+	const UnsignedInt id = ip & 0xFFu;
+	return (id >= 1 && id <= LOOPBACK_MAX_INSTANCES) ? id : 0;
+}
+
+Bool IsBroadcast(UnsignedInt ip)
+{
+	return ip == 0xFFFFFFFFu || ip == 0x7FFFFFFFu;
+}
+} // namespace
 
 
