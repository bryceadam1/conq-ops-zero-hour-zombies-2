+// ZHBO: one datagram out, through the loopback instance ports when they are on (see the top).
+Int Transport::sendDatagram( const unsigned char *buf, Int len, UnsignedInt addr, UnsignedShort port )
+{
+	if (m_loopbackBasePort == 0)
+		return m_udpsock->Write(buf, len, addr, port);
+	if (IsBroadcast(addr))
+	{
+		// Every other instance's offset port; one that is not running is not an error.
+		const UnsignedInt self = rts::ClientInstance::getInstanceId();
+		for (UnsignedInt id = 1; id <= LOOPBACK_MAX_INSTANCES; ++id)
+			if (id != self)
+				m_udpsock->Write(buf, len, LOOPBACK_HOST, (UnsignedShort)(port + id * LOOPBACK_PORT_STRIDE));
+		return len;
+	}
+	if (const UnsignedInt id = LoopbackInstanceOf(addr))
+		return m_udpsock->Write(buf, len, LOOPBACK_HOST, (UnsignedShort)(port + id * LOOPBACK_PORT_STRIDE));
+	return m_udpsock->Write(buf, len, addr, port);
+}
