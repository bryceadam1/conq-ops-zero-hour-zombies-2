@@ -3170,6 +3170,38 @@ void W3DDisplay::drawRemainingRectClock(Int startX, Int startY, Int width, Int h
 /** Draws an images at the screen coordinates and keeps it within the end
 	* screen coords specified */
 //=============================================================================
+// ZHBO (host patch 0033): the image's atlas cell on the quad `corners` (top-left, top-right,
+// bottom-right, bottom-left of the image, x, y pairs), as two triangles; an atlas cell packed
+// turned 90 degrees clockwise has its texture corners turned to match (as drawImage does).
+Bool W3DDisplay::drawImageQuad( const Image *image, const Real *corners, Color color )
+{
+	if( image == nullptr || corners == nullptr )
+		return FALSE;
+	TextureClass *tex = nullptr;
+	if (BitIsSet(image->getStatus(), IMAGE_STATUS_RAW_TEXTURE))
+		tex = (TextureClass *)(image->getRawTextureData());
+	else
+		tex = WW3DAssetManager::Get_Instance()->Get_Texture(image->getFilename().str(), MIP_LEVELS_1);
+	setup2DRenderState(tex, DRAW_IMAGE_ALPHA, FALSE);
+	RectClass uv = makeAtlasSafeUVRect(image);
+	Vector2 p[4] = { Vector2(corners[0], corners[1]), Vector2(corners[2], corners[3]), Vector2(corners[4], corners[5]), Vector2(corners[6], corners[7]) };
+	Vector2 t[4] = { Vector2(uv.Left, uv.Top), Vector2(uv.Right, uv.Top), Vector2(uv.Right, uv.Bottom), Vector2(uv.Left, uv.Bottom) };
+	if( BitIsSet( image->getStatus(), IMAGE_STATUS_ROTATED_90_CLOCKWISE ) )
+	{
+		t[0] = Vector2(uv.Right, uv.Top);
+		t[1] = Vector2(uv.Right, uv.Bottom);
+		t[2] = Vector2(uv.Left, uv.Bottom);
+		t[3] = Vector2(uv.Left, uv.Top);
+	}
+	m_2DRender->Add_Tri( p[0], p[1], p[2], t[0], t[1], t[2], color );
+	m_2DRender->Add_Tri( p[0], p[2], p[3], t[0], t[2], t[3], color );
+	if (!m_isBatching)
+		m_2DRender->Render();
+	if (tex != nullptr && !BitIsSet(image->getStatus(), IMAGE_STATUS_RAW_TEXTURE))
+		tex->Release_Ref();
+	return TRUE;
+}
