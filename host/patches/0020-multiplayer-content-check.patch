+				}
 				canJoin = false;
 			}
 #if defined(RTS_DEBUG)
@@ -501,6 +509,9 @@ void LANAPI::handleJoinDeny( LANMessage *msg, UnsignedInt senderIP )
 	{
 		if (m_pendingAction == ACT_JOIN) // Are we trying to join?
 		{
+			// ZHBO: the host's content parts, for the join-failed box to say which part differs.
+			if (msg->GameNotJoined.reason == LANAPIInterface::RET_CRC_MISMATCH)
+				Zhbo_NoteRefusedContent(msg->GameNotJoined.zhboContent, ZHBO_LAN_CONTENT_PARTS);
 			OnGameJoin(msg->GameNotJoined.reason, LookupGame(lanWideStrToUnicode(msg->GameNotJoined.gameName)));
 			m_pendingAction = ACT_NONE;
 			m_expiration = 0;
