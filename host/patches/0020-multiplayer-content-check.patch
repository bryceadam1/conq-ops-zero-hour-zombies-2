--- a/Core/GameEngine/Include/GameNetwork/LANAPI.h
+++ b/Core/GameEngine/Include/GameNetwork/LANAPI.h
@@ -143,6 +143,12 @@ public:
  * LAN message class
  */
 #pragma pack(push, 1)
+// ZHBO: the Conquer Ops content fingerprint's parts a join request and its refusal carry, so the
+// refused player is told which part differs (ZHBO_CONTENT_PARTS in host/zhbo/zhbo_core.h; the
+// bridge reads and writes them through Zhbo_ContentParts, by count). Appended at the end of their
+// union members, inside the union's existing size: the packet does not grow.
+enum { ZHBO_LAN_CONTENT_PARTS = 7 };
+
 struct LANMessage
 {
 	enum Type				          ///< What kind of message are we?
@@ -216,6 +222,7 @@ struct LANMessage
 			UnsignedInt exeCRC;
 			UnsignedInt iniCRC;
 			char serial[g_maxSerialLength];
+			UnsignedInt zhboContent[ZHBO_LAN_CONTENT_PARTS]; ///< ZHBO: the joiner's content fingerprint parts
 		} GameToJoin;
 
 		// GameJoined is sent with JOIN_ACCEPT
@@ -234,6 +241,7 @@ struct LANMessage
 			UnsignedInt gameIP;
 			UnsignedInt playerIP;
 			LANAPIInterface::ReturnType reason;
+			UnsignedInt zhboContent[ZHBO_LAN_CONTENT_PARTS]; ///< ZHBO: the host's parts, for a CRC refusal
 		} GameNotJoined;
 
 		// Accept is sent with SET_ACCEPT
