+// ZHBO: `UnclassifiedHardwareLOD = High` (GameLODPresets): the level getRecommendedStaticLODLevel
+// picks when the presets match nothing because the CPU is one they cannot classify.
+void parseUnclassifiedHardwareLOD(INI* ini)
+{
+	StaticGameLODLevel level = STATIC_GAME_LOD_UNKNOWN;
+	INI::parseStaticGameLODLevel(ini, nullptr, &level, nullptr);
+	if (level == STATIC_GAME_LOD_CUSTOM)
+	{
+		DEBUG_CRASH(("UnclassifiedHardwareLOD must name a preset level, not Custom"));
+		throw INI_INVALID_DATA;
+	}
+	if (TheGameLODManager)
+		TheGameLODManager->setUnclassifiedHardwareLOD(level);
+}
