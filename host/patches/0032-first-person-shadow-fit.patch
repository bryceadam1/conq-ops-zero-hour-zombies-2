+// ZHBO: the sun shadow's focus while Conquer Ops' first person owns the camera (host patch 0032).
+// W3DView's first-person hook sets it each frame from the camera it gives the view; the bgfx backend
+// then fits the sun's shadow map to a fixed box ahead of that eye instead of to the camera's ground
+// footprint, which a view at eye height (or diving to it) swings across the map frame to frame.
+static int s_zhboShadowFocus = 0;
+static float s_zhboShadowFocusEye[3] = { 0.0f, 0.0f, 0.0f };
+static float s_zhboShadowFocusDir[3] = { 0.0f, 0.0f, 0.0f };
+
+extern "C" void GGC_SetBgfxShadowFocus(int active, const float * eye, const float * dir)
+{
+	s_zhboShadowFocus = active;
+	for (int i = 0; i < 3 && active; ++i)
+	{
+		s_zhboShadowFocusEye[i] = eye[i];
+		s_zhboShadowFocusDir[i] = dir[i];
+	}
+}
+
+extern "C" int GGC_GetBgfxShadowFocus(float * eye, float * dir)
+{
+	for (int i = 0; i < 3 && s_zhboShadowFocus; ++i)
+	{
+		eye[i] = s_zhboShadowFocusEye[i];
+		dir[i] = s_zhboShadowFocusDir[i];
+	}
+	return s_zhboShadowFocus;
+}
