+// ------------------------------------------------------------------------------------------------
+// ZHBO: the flipbook cell to draw. The age is the logic updates this particle has had (its life
+// counts down once per update), so the cells advance at the logic rate like its other key frames.
+// A random start is a hash of the particle's personality: no random stream is drawn.
+UnsignedByte Particle::getFrame() const
+{
+	const UnsignedInt cells = 1u << (2 * m_system->getFrameGridLog2());
+	const UnsignedInt count = MIN( m_system->m_frameCount, cells );
+	if (count <= 1)
+		return 0;
+
+	UnsignedInt start;
+	switch (m_system->m_frameStartType)
+	{
+		case ParticleSystemInfo::FRAME_START_RANDOM:
+			start = ((m_personality + 1u) * 2654435761u) >> 8;
+			break;
+		case ParticleSystemInfo::FRAME_START_INDEXED:
+			start = m_personality;
+			break;
+		default:
+			start = m_system->m_frameStart;
+			break;
+	}
+	start %= count;
+
+	const UnsignedInt age = m_lifetime > m_lifetimeLeft ? m_lifetime - m_lifetimeLeft : 0;
+	UnsignedInt step = 0;
+	if (m_system->m_frameOverLife)
+		step = m_lifetime > 0 ? (UnsignedInt)(((UnsignedInt64)age * count) / m_lifetime) : 0;
+	else if (m_system->m_frameRate > 0.0f)
+		step = (UnsignedInt)((Real)age * m_system->m_frameRate / (Real)LOGICFRAMES_PER_SECOND);
+
+	const UnsignedInt loops = m_system->m_frameLoops;
+	if (loops > 0 && step >= loops * count)
+		step = loops * count - 1;
+
+	return (UnsignedByte)((start + step) % count);
+}
