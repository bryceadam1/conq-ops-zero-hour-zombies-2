+// ZHBO: a Conquer Ops BO2 surface's packed maps (`*_nsg.tga`, zhbo_assets::generals::surface_maps).
+static bool IsBo2MapsTexture(TextureBaseClass * texture)
+{
+    TextureClass * t = texture ? texture->As_TextureClass() : nullptr;
+    if (t == nullptr)
+    {
+        return false;
+    }
+    const char * name = t->Get_Texture_Name().str();
+    for (const char * c = name; c && *c; ++c)
+    {
+        if ((c[0] == '_') && (c[1] == 'n' || c[1] == 'N') && (c[2] == 's' || c[2] == 'S')
+            && (c[3] == 'g' || c[3] == 'G') && c[4] == '.')
+        {
+            return true;
+        }
+    }
+    return false;
+}
