+vec4 bo2Shade(vec4 albedo, vec4 maps, vec2 uv, vec4 vertexColor)
+{
+	// The material's own terms, as Zero Hour's lit path takes them (vertex colour or material).
+	vec3 matDiffuse = (u_vertexColorFlags.y > 0.5) ? vertexColor.rgb : u_matDiffuse.rgb;
+	vec3 matAmbient = (u_vertexColorFlags.z > 0.5) ? vertexColor.rgb : u_matAmbient.rgb;
+	vec3 matEmissive = (u_vertexColorFlags.w > 0.5) ? vertexColor.rgb : (u_matEmissive.rgb * u_matFx.w);
