+	// 4 specular only, 5 reflection only.
+	float debugMode = u_bo2Params.y;
+	vec3 n = (debugMode > 0.5 && debugMode < 1.5) ? geo : bo2PerturbNormal(geo, v_worldPos, uv, maps.rg * 2.0 - 1.0);
+	vec3 v = normalize(u_eyePos.xyz - v_worldPos);
+	float gloss = maps.b;
+	float f0 = maps.a * maps.a;
+	float power = min(exp2(1.0 + gloss * 11.0), BO2_MAX_POWER);
+	float norm = (power + 8.0) / 8.0;
+	float ao = albedo.a;
+
+	vec3 ambient = GGC_SCENE_AMBIENT.rgb * matAmbient;
+	vec3 direct = matEmissive;
+	vec3 spec = vec3(0.0, 0.0, 0.0);
+	vec3 sun = vec3(0.0, 0.0, 0.0);
+	for (int li = 0; li < 4; ++li)
+	{
+		if (u_lightParams[li].w > 0.5 || u_lightDirs[li].w > 0.5)
+		{
+			float ldirLen = length(u_lightDirs[li].xyz);
+			vec3 l = (ldirLen > 1e-5) ? (u_lightDirs[li].xyz / ldirLen) : vec3(0.0, 0.0, 1.0);
+			float atten = 1.0;
+			if (u_lightParams[li].z > 0.5)
+			{
+				vec3 toLight = u_lightPositions[li].xyz - v_worldPos;
+				float dist = length(toLight);
+				l = (dist > 0.0001) ? (toLight / dist) : vec3(0.0, 0.0, 1.0);
+				float inner = max(u_lightParams[li].x, 0.0001);
+				float outer = max(u_lightParams[li].y, inner);
+				float a1 = (outer - inner < 0.001) ? 0.0 : (0.1 / inner);
+				float a2 = 8.0 / (outer * outer);
+				atten = (dist <= outer) ? (1.0 / (1.0 + a1 * dist + a2 * dist * dist)) : 0.0;
+			}
+			else if (li == 0)
+			{
+				sun = u_lightColors[li].rgb;
+			}
+			// BO2 lights its weapons near neutral; Zero Hour's accent lights are strongly coloured
+			// (violet and blue), so keep most of their brightness and little of their colour.
+			vec3 lightColor = mix(vec3_splat(dot(u_lightColors[li].rgb, LUMA_WEIGHTS)), u_lightColors[li].rgb, BO2_LIGHT_SATURATION);
+			ambient += u_lightAmbients[li].rgb * matAmbient * atten;
+			float nDotL = max(0.0, dot(n, l));
+			// Wrap the geometric normal's shadow terminator so the normal map can't light the back.
+			float facing = clamp(dot(geo, l) * 4.0 + 1.0, 0.0, 1.0);
+			direct += lightColor * matDiffuse * nDotL * atten * facing;
+			vec3 h = normalize(l + v);
+			float vDotH = max(0.0, dot(v, h));
+			// Grazing highlights brighten on glossy surfaces only (rough ones scatter that light).
+			float fresnel = f0 + (1.0 - f0) * pow(1.0 - vDotH, 5.0) * gloss * gloss;
+			spec += lightColor * (pow(max(0.0, dot(n, h)), power) * norm * nDotL * atten * facing * fresnel);
+		}
+	}
