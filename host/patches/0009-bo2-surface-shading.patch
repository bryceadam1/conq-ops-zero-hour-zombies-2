+	// The surroundings: sky above, ground below, a bright horizon; rough surfaces see them blurred.
+	vec3 r = reflect(-v, n);
+	float blur = 1.0 - gloss;
+	float up = smoothstep(-0.25 - blur * 0.5, 0.25 + blur * 0.5, r.z);
