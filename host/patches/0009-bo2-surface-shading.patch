+// ZHBO: Black Ops II surfaces (Conquer Ops). The converter packs each opaque BO2 material's own maps
+// into stage 1 (r, g: tangent-space normal X and Y from BO2's normal map; b: gloss; a: specular
+// level) and its ambient occlusion into the colour map's alpha. This lights them as BO2's material
+// model does: per-pixel normals, a gloss-driven normalized Blinn-Phong highlight with Fresnel, and
+// a reflection of the surroundings (BO2 uses baked probes; Zero Hour maps have none, so the sky and
+// ground are built from the scene's own lights). Meshes carry no tangents: the frame comes from
+// screen-space derivatives of position and UV.
+#define BO2_NORMAL_Y 1.0
+#define BO2_MAX_POWER 2048.0
+#define BO2_LIGHT_SATURATION 0.35
+
+vec3 bo2PerturbNormal(vec3 n, vec3 p, vec2 uv, vec2 xy)
+{
+	vec3 dp1 = dFdx(p);
+	vec3 dp2 = dFdy(p);
+	vec2 duv1 = dFdx(uv);
+	vec2 duv2 = dFdy(uv);
+	vec3 dp2perp = cross(dp2, n);
+	vec3 dp1perp = cross(n, dp1);
+	vec3 t = dp2perp * duv1.x + dp1perp * duv2.x;
+	vec3 b = dp2perp * duv1.y + dp1perp * duv2.y;
+	float frame = max(dot(t, t), dot(b, b));
+	if (frame < 1e-20)
+	{
+		return n;
+	}
+	float invmax = inversesqrt(frame);
+	float z = sqrt(max(0.0, 1.0 - dot(xy, xy)));
+	return normalize(t * (xy.x * invmax) + b * (xy.y * BO2_NORMAL_Y * invmax) + n * z);
+}
