+	float ambientLevel = dot(ambient, LUMA_WEIGHTS);
+	float sunLevel = dot(sun, LUMA_WEIGHTS);
+	vec3 skyColor = vec3(0.92, 0.97, 1.05) * (ambientLevel * 1.4 + sunLevel * 0.35);
+	vec3 groundColor = vec3(1.0, 0.96, 0.9) * (ambientLevel * 0.45 + sunLevel * 0.08);
+	float horizon = exp(-r.z * r.z * (40.0 - blur * 36.0)) * (0.25 + 0.5 * gloss);
