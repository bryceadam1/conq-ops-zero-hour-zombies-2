 #include <stdlib.h>
 #include <windows.h>
 
@@ -1678,8 +1679,39 @@ void W3DView::update()
 		updateCameraAreaConstraints();
 	}
 
+	// ZHBO: the first-person General owns the camera while active
+	static Bool s_zhboCameraWasOverridden = false;
+	Coord3D zhboEye, zhboDir;
+	Real zhboFov;
+	if (Zhbo_GetCameraOverride(&zhboEye, &zhboDir, &zhboFov))
+	{
+		// Keep the terrain draw window centred ahead of the eye.
+		m_pos.x = zhboEye.x + zhboDir.x * 100.0f;
+		m_pos.y = zhboEye.y + zhboDir.y * 100.0f;
+		m_pos.z = zhboEye.z;
+		Matrix3D transform;
+		transform.Look_At_Dir(Vector3(zhboEye.x, zhboEye.y, zhboEye.z), Vector3(zhboDir.x, zhboDir.y, zhboDir.z), 0.0f);
+		m_3DCamera->Set_View_Plane(zhboFov, -1);
+		setCameraTransform(transform);
+		// The RTS near plane (one map cell) is as far away as the General's eye height.
+		float zhboNear, zhboFar;
+		m_3DCamera->Get_Clip_Planes(zhboNear, zhboFar);
+		m_3DCamera->Set_Clip_Planes(0.5f, std::max(zhboFar, 2000.0f));
+		m_recalcCamera = false;
+		s_zhboCameraWasOverridden = true;
+	}
+	else if (s_zhboCameraWasOverridden)
+	{
+		s_zhboCameraWasOverridden = false;
+		setWidth(getWidth()); // restores the RTS field of view
+		// The override moved the pivot up to eye height; put it back on the ground. The pitch and
+		// zoom are the player's, as first person found them (the transition back ends there).
+		resetPivotToGround();
+		m_recalcCamera = true;
+	}
+
 	// (gth) C&C3 if m_isCameraSlaved then force the camera to update each frame
-	if (m_recalcCamera || m_isCameraSlaved)
+	if (!s_zhboCameraWasOverridden && (m_recalcCamera || m_isCameraSlaved))
 	{
 		updateCameraTransform();
 		m_recalcCamera = false;
