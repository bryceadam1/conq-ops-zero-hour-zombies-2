diff --git a/Core/GameEngine/Include/Common/ZhboRenderStep.h b/Core/GameEngine/Include/Common/ZhboRenderStep.h
new file mode 100644
--- /dev/null
+++ b/Core/GameEngine/Include/Common/ZhboRenderStep.h
@@ -0,0 +1,30 @@
+/*
+** Conquer Ops (ZHBO, host patch 0031): presentation written for one 30 Hz step at the display's rate.
+**
+** Since host patch 0026 the render follows the display and WW3D::Sync steps W3D's clock every render
+** update by its share of a logic frame (W3DDisplay::update). Code that advanced a fixed amount per
+** draw call, or per W3D sync on the assumption that the clock only moved on a logic update ("Update
+** the draw on every WW Sync only"), then ran several times per logic frame. These say how much W3D
+** time this render update advanced, in logic frames; they read no logic state.
+*/
+#pragma once
+
+#include "Common/GameCommon.h"
+#include "WW3D2/ww3d.h"
+
+/// This render update's W3D time in logic frames (0 while the game is paused): the factor for a
+/// rate written per 30 Hz frame.
+inline Real zhboSyncLogicFrames()
+{
+	return (Real)WW3D::Get_Sync_Frame_Time() / MSEC_PER_LOGICFRAME_REAL;
+}
+
+/// How many whole logic frames of W3D time have passed, keeping the remainder in `carry`: run a step
+/// written for one 30 Hz frame (a spring, a state machine) that many times.
+inline Int zhboSyncLogicSteps(Real &carry)
+{
+	carry += zhboSyncLogicFrames();
+	const Int steps = (Int)carry;
+	carry -= (Real)steps;
+	return steps;
+}
