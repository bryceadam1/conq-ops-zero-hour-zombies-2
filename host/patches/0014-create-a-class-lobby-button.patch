+// BO2's create-a-class from the lobby: opens the class pick screen before the game starts, so the
+// player's General (the FPS avatar) spawns with the chosen kit instead of the base one. The pick
+// itself lands in the sim through MSG_ZHBO_CHOOSE_CLASS (see the Zhbo mod layer).
+static void handleCreateClassClick()
+{
+  // The class pick screen takes the mouse until the player picks or backs out.
+  Zhbo_ShowClassPick();
+}
+
+// The mod never ships the base game's .wnd files, so SkirmishGameOptionsMenu.wnd may not carry a
+// ButtonCreateClass element. When the lookup comes up empty we build the button in code and parent
+// it to the skirmish menu, on the pattern of ZhboControlBarAccess::injectConstructButtons. A shipped
+// .wnd element, if the art later provides one, takes precedence and this does nothing.
+static GameWindow *injectCreateClassButton( GameWindow *parent )
+{
+  if( parent == nullptr )
+    return nullptr;
+
+  // Borrow the map-select button's screen rect so the new button lands in the same column, below
+  // the map preview, without guessing at pixel coordinates for every resolution.
+  GameWindow *anchor = TheWindowManager->winGetWindowFromId( nullptr,
+    TheNameKeyGenerator->nameToKey( "SkirmishGameOptionsMenu.wnd:ButtonSelectMap" ) );
+  Int x = 10, y = 10, w = 120, h = 28;
+  if( anchor )
+  {
+    anchor->winGetScreenPosition( &x, &y );
+    anchor->winGetSize( &w, &h );
+    y += h + 4;
+  }
+
+  WinInstanceData instData;
+  instData.init();
+  BitSet( instData.m_style, GWS_PUSH_BUTTON | GWS_MOUSE_TRACK );
+  instData.m_textLabelString = "Create a Class";
+
+  GameWindow *button = TheWindowManager->gogoGadgetPushButton( parent,
+    WIN_STATUS_ENABLED | WIN_STATUS_IMAGE, x, y, w, h, &instData, nullptr, FALSE );
+  if( button == nullptr )
+    return nullptr;
+
+  // Give the button the same id the .wnd element would have, so the menu's system handler routes
+  // its clicks through the same comparison.
+  button->winSetWindowId( buttonCreateClassID );
+  return button;
+}
+
 
