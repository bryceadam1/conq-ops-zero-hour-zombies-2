+// BO2's create-a-class from the lobby: opens the class pick screen before the game starts, so the
+// player's General (the FPS avatar) spawns with the chosen kit instead of the base one. The pick
+// itself lands in the sim through MSG_ZHBO_CHOOSE_CLASS (see the Zhbo mod layer).
+static void handleCreateClassClick()
+{
+  // The class pick screen takes the mouse until the player picks or backs out.
+  Zhbo_ShowClassPick();
+}
+
+// The mod never ships the base game's .wnd files, so SkirmishGameOptionsMenu.wnd may not carry a
+// ButtonCreateClass element. When the lookup comes up empty we build the button in code and parent
+// it to the skirmish menu, on the pattern of ZhboControlBarAccess::injectConstructButtons. A shipped
+// .wnd element, if the art later provides one, takes precedence and this does nothing. Called from
+// the menu's Init, once the layout is settled, so the parent's own rect is real.
+static GameWindow *injectCreateClassButton( GameWindow *parent )
+{
+  if( parent == nullptr )
+    return nullptr;
+
+  // Same size and font as the neighbouring Start button, so it reads as one of the shell's own.
+  Int w = 174, h = 36;
+  GameFont *font = nullptr;
+  if( buttonStart )
+  {
+    buttonStart->winGetSize( &w, &h );
+    font = buttonStart->winGetFont();
+  }
+  if( font == nullptr )
+    font = TheWindowManager->winFindFont( "Times New Roman", 14, FALSE );
+
+  // Sit in the empty top-right of the menu's panel, aligned with the title row. Anchored to the
+  // panel (a named sibling) so it scales with the layout; fall back to the parent's lower-right.
+  // gogoGadgetPushButton takes parent-relative coordinates, unlike winGetScreenPosition.
+  Int px = 0, py = 0, pw = 0, ph = 0;
+  parent->winGetScreenPosition( &px, &py );
+  parent->winGetSize( &pw, &ph );
+  Int x = pw - w - 20, y = ph - h - 20;
+  GameWindow *panel = TheWindowManager->winGetWindowFromId( parent,
+    TheNameKeyGenerator->nameToKey( "SkirmishGameOptionsMenu.wnd:SubParent" ) );
+  if( panel )
+  {
+    Int rx = 0, ry = 0, rw = 0, rh = 0;
+    panel->winGetScreenPosition( &rx, &ry );
+    panel->winGetSize( &rw, &rh );
+    x = rx - px + rw - w - 4;
+    y = ry - py + 4;
+  }
+
+  WinInstanceData instData;
+  instData.init();
+  BitSet( instData.m_style, GWS_PUSH_BUTTON | GWS_MOUSE_TRACK );
+
+  // The plain draw path, not WIN_STATUS_IMAGE: the image path paints only the gadget's images, and
+  // assignDefaultGadgetLook assigns none here (the retail shell uses its own Buttons-* images).
+  GameWindow *button = TheWindowManager->gogoGadgetPushButton( parent,
+    WIN_STATUS_ENABLED | WIN_STATUS_NO_FOCUS, x, y, w, h, &instData, font, FALSE );
+  if( button == nullptr )
+    return nullptr;
+
+  // Set the text and its colours directly: assignDefaultGadgetLook skips them when defaultVisual is
+  // FALSE, and an undefined colour has zero alpha, which is what made the old button invisible.
+  // The text colours are the Start button's; the fill is the menu panel's dark style.
+  GadgetButtonSetText( button, UnicodeString( L"Create a Class" ) );
+  button->winSetEnabledTextColors( TheWindowManager->winMakeColor( 255, 255, 255, 255 ),
+                                   TheWindowManager->winMakeColor( 0, 0, 0, 255 ) );
+  button->winSetDisabledTextColors( TheWindowManager->winMakeColor( 62, 64, 92, 255 ),
+                                    TheWindowManager->winMakeColor( 31, 32, 47, 255 ) );
+  button->winSetHiliteTextColors( TheWindowManager->winMakeColor( 186, 255, 12, 255 ),
+                                  TheWindowManager->winMakeColor( 0, 2, 0, 255 ) );
+  GadgetButtonSetEnabledColor( button, TheWindowManager->winMakeColor( 2, 2, 2, 220 ) );
+  GadgetButtonSetEnabledBorderColor( button, TheWindowManager->winMakeColor( 47, 55, 168, 255 ) );
+  GadgetButtonSetHiliteColor( button, TheWindowManager->winMakeColor( 24, 32, 60, 235 ) );
+  GadgetButtonSetHiliteBorderColor( button, TheWindowManager->winMakeColor( 186, 255, 12, 255 ) );
+  GadgetButtonSetDisabledColor( button, TheWindowManager->winMakeColor( 16, 16, 20, 220 ) );
+  GadgetButtonSetDisabledBorderColor( button, TheWindowManager->winMakeColor( 64, 64, 80, 255 ) );
+  button->winSetTooltip( UnicodeString( L"Browse, edit and manage your custom classes" ) );
+
+  // Give the button the same id the .wnd element would have, so the menu's system handler routes
+  // its clicks through the same comparison.
+  button->winSetWindowId( buttonCreateClassID );
+  return button;
+}
+
+/// Make sure the Create a Class button exists. The layout's windows are destroyed when the shell
+/// pops the menu, so the cached pointer is stale on a later visit: look the button up on the fresh
+/// layout and rebuild it only when it is missing. Idempotent within one layout.
+static void ensureCreateClassButton()
+{
+  buttonCreateClass = TheWindowManager->winGetWindowFromId( parentSkirmishGameOptions, buttonCreateClassID );
+  if( buttonCreateClass == nullptr )
+    buttonCreateClass = injectCreateClassButton( parentSkirmishGameOptions );
+  DEBUG_ASSERTCRASH(buttonCreateClass, ("Could not create the buttonCreateClass"));
+}
