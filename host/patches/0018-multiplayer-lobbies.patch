-  }
-  if( font == nullptr )
-    font = TheWindowManager->winFindFont( "Times New Roman", 14, FALSE );
-
-  // Sit in the empty top-right of the menu's panel, aligned with the title row. Anchored to the
-  // panel (a named sibling) so it scales with the layout; fall back to the parent's lower-right.
-  // gogoGadgetPushButton takes parent-relative coordinates, unlike winGetScreenPosition.
-  Int px = 0, py = 0, pw = 0, ph = 0;
-  parent->winGetScreenPosition( &px, &py );
-  parent->winGetSize( &pw, &ph );
-  Int x = pw - w - 20, y = ph - h - 20;
-  GameWindow *panel = TheWindowManager->winGetWindowFromId( parent,
-    TheNameKeyGenerator->nameToKey( "SkirmishGameOptionsMenu.wnd:SubParent" ) );
