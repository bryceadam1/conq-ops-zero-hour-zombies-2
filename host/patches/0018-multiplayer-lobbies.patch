-  {
-    Int rx = 0, ry = 0, rw = 0, rh = 0;
-    panel->winGetScreenPosition( &rx, &ry );
-    panel->winGetSize( &rw, &rh );
-    x = rx - px + rw - w - 4;
-    y = ry - py + 4;
-  }
-
-  WinInstanceData instData;
-  instData.init();
-  BitSet( instData.m_style, GWS_PUSH_BUTTON | GWS_MOUSE_TRACK );
-
-  // The plain draw path, not WIN_STATUS_IMAGE: the image path paints only the gadget's images, and
-  // assignDefaultGadgetLook assigns none here (the retail shell uses its own Buttons-* images).
-  GameWindow *button = TheWindowManager->gogoGadgetPushButton( parent,
