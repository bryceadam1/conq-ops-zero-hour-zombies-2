@@ -6814,6 +6814,12 @@
 void BgfxBackend::Set_Index_Buffer_Index_Offset(unsigned int offset)
 {
     g_draw.ibOffset = static_cast<unsigned short>(offset);
+    // ZHBO: keep the shared render state in step, as DX8Wrapper does. The sorting renderer
+    // captures it for each translucent draw and replays from it; without this every sorted mesh
+    // in a shared vertex buffer (skins, rigid categories) read the offset of the last
+    // Set_Index_Buffer (usually the first mesh's), drawing its triangles from another mesh's
+    // vertices: long streaks between unrelated translucent surfaces.
+    FixedFunctionState::Render_State().index_base_offset = static_cast<unsigned short>(offset);
 }
 
